{
  "name": "laconic-skill",
  "version": "0.1.2",
  "description": "Open source deterministic concise-response skill and runtime",
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "examples/",
    "README.md",
    "NOTICE",
    "LICENSE",
    "INTENTION.md",
    "package.json"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "laconic": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node test/laconic.test.js",
    "benchmark": "npm run build && tsc -p tsconfig.benchmark.json && node dist/scripts/benchmark.js"
  },
  "keywords": [
    "skill",
    "deterministic",
    "brevity",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.15.19",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.29.0"
  }
}
